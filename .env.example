# ============================================================
# Ogolne
# ============================================================
TZ=Europe/Warsaw
NFDUMP_VERSION=1.7.7

# ============================================================
# Kolektor (nfcapd)
# ============================================================
DATA_DIR=./nfcapd/data
FLOW_DIR=/flows
# HOST_IP=192.168.1.1     # Opcjonalnie: bind do konkretnego IP hosta
#                         # Jesli nieustawione, nasluchuje na wszystkich interfejsach
PORT=12345
SUBDIR_FORMAT=1
ROTATE_INTERVAL=300

# ============================================================
# Retencja (nfcapd-retention)
# ============================================================
RETENTION_SLEEP=3600

# ============================================================
# Monitor (nfcapd-monitor)
# ============================================================
# Aplikacja ntfy: https://ntfy.sh
# iOS/Android: autor "Philipp Heckel" (ikona niebieska)
# Wybierz unikalny, trudny do odgadniecia topic, np.: nfcapd-firma-x7k2m
NTFY_URL=https://ntfy.sh/twoj-unikalny-topic
HOSTNAME_LABEL=
# FILE_AGE_THRESHOLD=15   # Minuty bez nowego pliku = alert (domyslnie: 15)
# DISK_THRESHOLD=90       # % zajętosci dysku = alert (domyslnie: 90)
# CHECK_INTERVAL=300      # Sekundy miedzy sprawdzeniami (domyslnie: 300)
